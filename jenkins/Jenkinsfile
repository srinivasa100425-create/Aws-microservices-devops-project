
pipeline {
    agent any

    environment {
        AWS_DEFAULT_REGION = 'ap-south-1'
        AWS_ACCOUNT_ID = '131166809923'
        ECR_REGISTRY = '131166809923.dkr.ecr.ap-south-1.amazonaws.com'
        IMAGE_TAG = "build-${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Source code checked out through Jenkins SCM.'
            }
        }

        stage('Configuration Validation') {
            steps {
                bat 'docker compose config -q'
            }
        }

        stage('Build Docker Images') {
            steps {
                bat '''
                    docker build -t %ECR_REGISTRY%/user-service:%IMAGE_TAG% services/user-service
                    docker build -t %ECR_REGISTRY%/product-service:%IMAGE_TAG% services/product-service
                    docker build -t %ECR_REGISTRY%/order-service:%IMAGE_TAG% services/order-service
                '''
            }
        }

        stage('Docker Image Verification') {
            steps {
                bat '''
                    docker images %ECR_REGISTRY%/user-service
                    docker images %ECR_REGISTRY%/product-service
                    docker images %ECR_REGISTRY%/order-service
                '''
            }
        }

        stage('ECR Authentication and Push') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-ecr-credentials'
                ]]) {
                    bat '''
                        aws ecr get-login-password --region %AWS_DEFAULT_REGION% | docker login --username AWS --password-stdin %ECR_REGISTRY%
                        if errorlevel 1 exit /b 1

                        docker push %ECR_REGISTRY%/user-service:%IMAGE_TAG%
                        if errorlevel 1 exit /b 1

                        docker push %ECR_REGISTRY%/product-service:%IMAGE_TAG%
                        if errorlevel 1 exit /b 1

                        docker push %ECR_REGISTRY%/order-service:%IMAGE_TAG%
                        if errorlevel 1 exit /b 1

                        docker logout %ECR_REGISTRY%
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'All microservice images were successfully pushed to AWS ECR.'
        }
        failure {
            echo 'Jenkins pipeline failed. Check the console output for details.'
        }
    }
}
